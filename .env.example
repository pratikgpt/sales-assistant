# Postgres (local Docker or Neon)
DATABASE_URL=postgres://postgres:dev@localhost:5433/sales

# LLM via OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Dashboard access (the dashboard shows real customer conversations)
DASHBOARD_PASSWORD=

# WhatsApp Cloud API
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Instagram API with Instagram Login
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=

# Email inbox (Gmail with an app password: IMAP to read, SMTP to reply)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com

# Google Calendar via a service account; each rep's test calendar is shared with it
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID_REP_1=
GOOGLE_CALENDAR_ID_REP_2=

# Vercel Cron / external scheduler calls the email poll with this bearer secret
CRON_SECRET=
